# Copy to .env.local and fill in. .env.local is gitignored and must NEVER be committed.
# Add the same variables in Vercel → Project → Settings → Environment Variables.

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model
# GEMINI_MODEL=gemini-2.5-flash

# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret! Server-only, bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
# Generate one with: openssl rand -hex 32
CRON_SECRET=
